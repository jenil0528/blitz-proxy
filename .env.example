# BlitzProxy — optional environment input
#
# API keys are normally managed securely:   blitz add <api-key>
# They are stored in your OS keyring (DPAPI / Keychain / Secret Service),
# NOT in this file.
#
# This file is honored as INPUT only. BlitzProxy never writes secrets here.
# Environment values override config.json (power-user escape hatch).

# Your API key (provider auto-detected from prefix)
#API_KEY=

# Explicit provider (nvidia, groq, openrouter, deepseek, gemini, mistral,
# cerebras, together, fireworks, sambanova, xai, openai, github,
# huggingface, ollama, custom)
#PROVIDER=

# Model override
#MODEL=

# Proxy port (default 4819)
#PROXY_PORT=4819

# Request timeout in ms (default: per-provider)
#TIMEOUT=

# Log level: debug | info | warn | error
#LOG_LEVEL=info
